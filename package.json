{
  "name": "open-velo-core",
  "version": "0.4.0",
  "description": "Self-contained Rust/WASM cycling telemetry, smart trainer protocol, physiology, workout compliance, and .FIT SDK",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "rust",
    "Cargo.toml"
  ],
  "scripts": {
    "build:wasm": "cargo build --target wasm32-unknown-unknown --release && node scripts/embed-wasm.mjs",
    "build": "npm run build:wasm && npm run lint",
    "test:rust": "cargo test",
    "test:ts": "tsx --test tests/wasm-engine.test.ts",
    "test": "npm run test:rust && npm run build:wasm && npm run test:ts",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist target"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
